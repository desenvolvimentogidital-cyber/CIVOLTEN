{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/v1/:route*",
      "destination": "/api/index?route=:route*"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/secure.html",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/secure.html",
      "permanent": false
    },
    {
      "source": "/demo-api.js",
      "destination": "/secure.html",
      "permanent": false
    },
    {
      "source": "/app.js",
      "destination": "/secure.html",
      "permanent": false
    }
  ]
}
