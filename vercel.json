{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self),camera=(),geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/teste",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/orcamento",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/orcamentos",
      "destination": "/",
      "permanent": false
    }
  ]
}
