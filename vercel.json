{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self),camera=(),geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' https://rvhnuowqfdugcecgmxnv.supabase.co; img-src 'self' blob: data: https://rvhnuowqfdugcecgmxnv.supabase.co https://images.pexels.com; media-src 'self' blob: https://rvhnuowqfdugcecgmxnv.supabase.co; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        }
      ]
    },
    {
      "source": "/empresa",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/teste",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/orcamentos",
      "destination": "/orcamento",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/orcamento",
      "destination": "/index.html"
    },
    {
      "source": "/empresa",
      "destination": "/index.html"
    }
  ]
}
